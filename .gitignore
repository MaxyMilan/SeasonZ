# Private signing key: never in git
signing-private/
*.biprivatekey

# Build output and packaged releases (built from source with AddonBuilder)
build/
releases/
*.pbo
*.bisign

# Local test environment, QA screenshots and trailer material
testenv/
report-*/
trailer/

# Python caches
__pycache__/
*.pyc

# Local tools (headless Blender, the DZOB model reader (GPL, not shipped), their config and temp files)
tools/ext/

# Generated snow caps (5.4 GB of MLOD source models): made again with tools/craft_all.py from the game's models
source/SeasonZ/data/baked/

# (approved snow meshes are kept in git: they are the reviewed product, not regenerable once the generator moves on)
